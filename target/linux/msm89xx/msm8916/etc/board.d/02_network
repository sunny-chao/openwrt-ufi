. /lib/functions.sh
. /lib/functions/uci-defaults.sh
. /lib/functions/system.sh

msm8916_setup_interfaces()
{
	board=$1

	case "$board" in
		ufi,*)
		ucidef_set_interface_lan usb0
		;;
	esac
}

board_config_update
board=$(board_name)
msm8916_setup_interfaces $board
#msm8916_setup_macs $board
board_config_flush

exit 0
